[Unit]
Description=ramme ambient signage server
After=network-online.target
Wants=network-online.target

# `pi` is a placeholder; the README's install command substitutes your username.
[Service]
User=pi
WorkingDirectory=/home/pi/ramme
ExecStart=/usr/bin/node build/index.js
Environment=PORT=3000
Environment=HOST=127.0.0.1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
