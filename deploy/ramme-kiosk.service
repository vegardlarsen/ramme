[Unit]
Description=ramme kiosk browser (cage)
After=ramme-signage.service
Wants=ramme-signage.service
Conflicts=getty@tty1.service

# `pi` is a placeholder; the README's install command substitutes your username.
[Service]
User=pi
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
ExecStart=/usr/bin/cage -- /bin/sh -c 'wlr-randr --output HDMI-A-1 --transform 270; exec "$$(command -v chromium chromium-browser | head -n1)" --kiosk --noerrdialogs --disable-session-crashed-bubble --disable-features=TranslateUI --check-for-update-interval=31536000 http://localhost:3000'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
