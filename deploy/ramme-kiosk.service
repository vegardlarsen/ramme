[Unit]
Description=ramme kiosk browser (cage)
After=ramme-signage.service
Wants=ramme-signage.service
Conflicts=getty@tty1.service

[Service]
User=pi
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
ExecStart=/usr/bin/cage -- /bin/sh -c 'wlr-randr --output HDMI-A-1 --transform 90; exec chromium-browser --kiosk --noerrdialogs --disable-session-crashed-bubble --disable-features=TranslateUI --check-for-update-interval=31536000 http://localhost:3000'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
